{
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-svelte"],
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "trailingComma": "none",
  "printWidth": 120,
  "semi": true,
  "importOrder": ["^node:(.*)$", "<THIRD_PARTY_MODULES>", "^[.]"],
  "importOrderTypeScriptVersion": "5.0.0"
}
